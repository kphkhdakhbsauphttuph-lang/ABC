@echo off
title Windows Ultimate FPS Booster
color 0A
echo ===================================================
echo     OPTIMIZING YOUR PC FOR MAXIMUM FPS & PERFORMANCE
echo ===================================================
echo.

:: 1. Clear Temporary Files & Cache
echo [1/4] Cleaning System Cache and Temporary Files...
del /s /f /q %temp%\*.* >nul 2>&1
rd /s /q %temp% >nul 2>&1
md %temp% >nul 2>&1
del /s /f /q C:\Windows\Temp\*.* >nul 2>&1
rd /s /q C:\Windows\Temp >nul 2>&1
md C:\Windows\Temp >nul 2>&1
del /s /f /q C:\Windows\Prefetch\*.* >nul 2>&1
echo Done!
echo.

:: 2. Flush DNS & Reset Network
echo [2/4] Flushing DNS Cache for lower latency...
ipconfig /flushdns >nul 2>&1
echo Done!
echo.

:: 3. Enable Ultimate Performance Power Plan
echo [3/4] Unlocking Ultimate Performance Power Plan...
powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 >nul 2>&1
powercfg /setactive e9a42b02-d5df-448d-aa00-03f14749eb61 >nul 2>&1
echo Done!
echo.

:: 4. Registry Tweaks for Gaming Response
echo [4/4] Applying Low-Latency Gaming Registry Tweaks...
:: Disable Network Throttling
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "NetworkThrottlingIndex" /t REG_DWORD /d 0xffffffff /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "SystemResponsiveness" /t REG_DWORD /d 0x00000000 /f >nul 2>&1
:: Prioritize Gaming Tasks
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "GPU Priority" /t REG_DWORD /d 8 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Priority" /t REG_DWORD /d 6 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Scheduling Category" /t REG_SZ /d "High" /f >nul 2>&1
echo Done!
echo.

echo ===================================================
echo   OPTIMIZATION COMPLETE! Restart your PC for best results.
echo ===================================================
pause
